# Public build-time configuration. None of these are secrets.
# Leave empty until the genuine value exists; the site stays honest when empty.

# Real Chrome Web Store listing URL (do not invent one)
VITE_CHROME_STORE_URL=

# HTTPS endpoint that accepts POST {"email": "...", "source": "download-page"}
VITE_EARLY_ACCESS_ENDPOINT=

# Verified contact address (shown in footer, used as mailto fallback)
VITE_CONTACT_EMAIL=

# Only set once a released version is verified
VITE_RELEASE_VERSION=
